# 忽略操作系统生成的文件
.DS_Store
Thumbs.db

# 忽略 IDE 配置文件
.vscode/
.idea/
*.suo
*.user
*.sln

# 忽略临时文件和日志文件
*.log
*.tmp
*.temp

# 忽略 node_modules 目录
node_modules/

# 忽略 Excel 临时文件
~$*.xlsx
~$*.xls

# 忽略编译生成的文件
*.exe
*.dll
*.obj
*.pdb
*.lib

# 忽略本地配置文件（如 API 密钥等）
.env
*.env

# 忽略构建目录
dist/
build/

# 忽略 Git 子模块目录
.gitmodules
